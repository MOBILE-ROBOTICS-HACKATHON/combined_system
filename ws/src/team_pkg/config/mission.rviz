Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid (0.5 m)
      Plane: XY
      Plane Cell Count: 8
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Marker Scale: 0.3
      Name: TF (world = takeoff point)
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cf1/robot_description
      Enabled: true
      Name: Drone cf1
      Visual Enabled: true
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 300
      Name: Trail
      Position Tolerance: 0.02
      Shape:
        Alpha: 1
        Axes Length: 0.05
        Axes Radius: 0.005
        Value: Axes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cf1/odom
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: ANT body (ant_link)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ant/marker
      Value: true
    - Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.02
      Class: rviz_default_plugins/Pose
      Color: 255; 170; 0
      Enabled: true
      Head Length: 0.15
      Head Radius: 0.08
      Name: ANT heading
      Shaft Length: 0.4
      Shaft Radius: 0.03
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ant/pose_room
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Fence / leash (cf_guard)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cf1/fence
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Name: Current View
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Yaw: 3.6
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
